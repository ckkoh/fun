# Database Configuration
DATABASE_URL=sqlite:///data/toto.db
# For PostgreSQL: postgresql://user:password@localhost:5432/toto_ml

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=your-secret-key-change-this-in-production

# ML Training
DEVICE=cpu  # or 'cuda' for GPU
MODEL_DIR=models/checkpoints
LOG_LEVEL=INFO

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=toto-prediction

# Data Collection
SCRAPER_RATE_LIMIT=2.0
SCRAPER_MAX_RETRIES=3
